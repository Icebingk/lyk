  17          //---------------------------------------------------//
  18          sbit ad9833_sdata   =P1^0;
  19          sbit ad9833_sclk    =P1^1;
  20          sbit ad9833_fsync   =P1^2;
  21          //---------------------------------------------------//
  22          //延时程序
  23          //---------------------------------------------------//
  24          void delay(unsigned int m)
  25          {
  26   1      unsigned int  n;
  27   1      for (n=0;n<=m;n++)
  28   1      {
  29   2      }
  30   1      }
  31          //---------------------------------------------------//
  32          //向AD9833写16位数据
  33          //---------------------------------------------------//
  34          void write_ad9833_d16(unsigned int x)
  35          {
  36   1      int i,w;
  37   1      ad9833_sclk=1;
  38   1      ad9833_fsync=1;
  39   1      ad9833_fsync=0;
  40   1      //写16位数据
  41   1      w=x;
  42   1      for(i=0;i<16;i++)
  43   1      {
  44   2      ad9833_sdata=w&0x8000;
  45   2      ad9833_sclk=0;
  46   2      ad9833_sclk=1;
  47   2      w=w<<1;
  48   2      }
  49   1      ad9833_fsync=1;
  50   1      ad9833_sclk=0;
  51   1      }
  52          //---------------------------------------------------//
  53          //                   主程序                          //
  54          //---------------------------------------------------//
  55          main()
